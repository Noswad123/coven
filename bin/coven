#!/bin/sh
set -eu

fail() {
  printf '[ERROR] %s\nBuild explicitly with cargo build --release --bin coven in the checkout, or set COVEN_NATIVE_BIN to an absolute prebuilt binary path.\n' "$1" >&2
  exit 1
}

if [ "${COVEN_NATIVE_BIN+x}" = x ]; then
  native_bin=$COVEN_NATIVE_BIN
  case "$native_bin" in
    /*) ;;
    *) fail 'COVEN_NATIVE_BIN must be an absolute path.' ;;
  esac
else
  # Normal checkout resolution uses shell builtins only, even with an empty PATH.
  script=$0
  links=0
  while [ -L "$script" ]; do
    [ "$links" -lt 40 ] || fail 'Wrapper symlink chain exceeds 40 links (possible symlink cycle).'
    links=$((links + 1))
    if [ -n "${PATH:-}" ]; then
      target=$(readlink "$script") || fail 'Cannot read wrapper symlink.'
    elif [ -x /usr/bin/readlink ]; then
      target=$(/usr/bin/readlink "$script") || fail 'Cannot read wrapper symlink.'
    else
      target=$(/bin/readlink "$script") || fail 'Cannot read wrapper symlink.'
    fi
    case "$target" in
      /*) script=$target ;;
      *) case "$script" in
           */*) script=${script%/*}/$target ;;
           *) script=./$target ;;
         esac ;;
    esac
  done
  case "$script" in
    */*) script_dir=${script%/*} ;;
    *) script_dir=. ;;
  esac
  checkout=$(CDPATH= cd -P -- "$script_dir/.." && pwd -P) || fail 'Cannot resolve checkout.'
  native_bin=$checkout/target/release/coven
fi

[ -f "$native_bin" ] && [ -x "$native_bin" ] || fail "Missing or non-executable native coven: $native_bin"
[ ! "$native_bin" -ef "$0" ] || fail 'Native coven selection resolves to this wrapper (recursive invocation).'

exec "$native_bin" "$@"
