 clock2:\n    clock.now.return_value = now\n    clock2.now.return_value = now\n    exec(compile(source, str(root / helper), \"exec\"), {\"__file__\": str(root / helper), \"coven\": coven})\n", "exact_source_patches": {"src/execution/mutation/oracle.py": [["        return {\"control\": control, \"revision\": revision, \"attempt\": attempt,", "        persisted = (root / \"state/execution/control.json\").read_text()\n        with storage.workspace_lock(root, root / \"state/.workspace.lock\") as held:\n            retry = store.mutate(\"cancel\", {\"attempt_id\": attempt, \"reason\": \"  withdraw \\u03bb\\n\"},\n                expected_execution_revision=revision, expected_tasks_revision=None,\n                request_id=\"cancel\", source_loader=source, lock=held)\n        assert (root / \"state/execution/control.json\").read_text() == persisted\n        import io\n        from contextlib import redirect_stdout\n        def render(value, mode):\n            output = io.StringIO()\n            with redirect_stdout(output):\n                status = coven.print_execution_result(value, mode)\n            assert status == 0\n            return output.getvalue().removesuffix(\"\\n\")\n        def native_render(value, mode):\n            # Native compact CLI deliberately omits historical CLI spaces.\n            return json.dumps(value, ensure_ascii=True, separators=(\",\", \":\")) if mode else render(value, mode)\n        return {\"retry\": retry,\n                \"python_rendered\": [render(result, mode) for mode in (False, True)],\n                \"python_retry_rendered\": [render(retry, mode) for mode in (False, True)],\n                \"rendered\": [native_render(result, mode) for mode in (False, True)],\n                \"retry_rendered\": [native_render(retry, mode) for mode in (False, True)],\n                \"control\": control, \"revision\": revision, \"attempt\": attempt,"]], "src/execution/mutation/graphs/oracle.py": [], "src/execution/mutation/effects/oracle.py": []}, "metadata_seam": "Outer uuid4 sequential 32-hex IDs; both module clocks fixed to NOW. Original inner UUID/time patches take precedence. No business logic mocked.", "corpus_sha256": "7b574a0087903c171a8d18db5ff5e987d9c0b18066078bd8359ddfb0ae20025c", "counts": [2, 25, 23], "case_ids": [["standalone-v1", "standalone-v2"], ["fresh-two-node-downstream-first", "proposed-managed-task-cannot-use-standalone", "wrong-digest-rejected", "approve-unrelated-revision-change", "downstream-does-not-dispatch-or-wait", "independent-upstream-reservation", "source-free-revocation-preserves-reservations", "revoked-review-rejects-prepare", "prepared-blocks-reapproval", "prepared-blocks-successor-even-removed-node", "successor-preserves-family-and-head", "removed-node-sticky-managed-cannot-use-standalone", "old-head-rejected", "source-free-review-still-requires-current-head", "successor-needs-fresh-review", "approve-successor", "removed-node-remains-unavailable", "selected-int-float-drift-rejected", "missing-owner-rejected", "authority-change-rejected", "rebound-enrollment-invalidates-old-graph", "successor-freezes-current-ledger-and-binding", "approve-rebound-successor", "graph-bound-attempt-chain-after-rebind", "ledger-source-free-revocation"], ["v1-enable", "v1-enroll", "v1-reenroll", "v1-rebind", "v1-rebind_denied", "v1-edited", "v1-missing_enrollment", "v1-missing_task", "v1-owner", "v1-roster", "v1-source_changed", "v1-chain", "v2-enroll", "v2-reenroll", "v2-rebind", "v2-rebind_denied", "v2-edited", "v2-missing_enrollment", "v2-missing_task", "v2-owner", "v2-roster", "v2-source_changed", "v2-chain"]], "proof": "All sources verified before execution; each helper run twice identically. Complete raw stdout and rows retained. Opaque strings parsed only with native Authority profile. All predecessor controls independently produced by historical Python; no native output or encoder used."}
